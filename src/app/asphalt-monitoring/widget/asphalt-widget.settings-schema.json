{
  "schema": {
    "type": "object",
    "title": "Asphalt dashboard settings",
    "properties": {
      "tankDeviceTypes": {
        "title": "Tank device profiles",
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "Asphalt tank"
        ]
      },
      "newTankDeviceType": {
        "title": "Device profile for tanks added from the dashboard",
        "type": "string",
        "default": "Asphalt tank"
      },
      "levelPercentKey": {
        "title": "Telemetry: level, % of capacity",
        "type": "string",
        "default": "tankLevel"
      },
      "levelKey": {
        "title": "Telemetry: sensor level reading",
        "type": "string",
        "default": "level"
      },
      "temperatureKey": {
        "title": "Telemetry: temperature (°C)",
        "type": "string",
        "default": "temperature"
      },
      "tonnageKey": {
        "title": "Telemetry: tonnage (t)",
        "type": "string",
        "default": "tonnage"
      },
      "batteryKey": {
        "title": "Telemetry: battery (%)",
        "type": "string",
        "default": "battery"
      },
      "liquidTypeKey": {
        "title": "Attribute: product",
        "type": "string",
        "default": "liquidType"
      },
      "capacityKey": {
        "title": "Attribute: capacity",
        "type": "string",
        "default": "tankCapacity"
      },
      "capacityUnitsKey": {
        "title": "Attribute: capacity units",
        "type": "string",
        "default": "tankCapacityOutput"
      },
      "sensorUnitsKey": {
        "title": "Attribute: sensor reading units",
        "type": "string",
        "default": "sensorDimensionUnits"
      },
      "minLevelThresholdKey": {
        "title": "Attribute: tank minimum level",
        "type": "string",
        "default": "minLevelThreshold"
      },
      "levelAlarmTypes": {
        "title": "Alarm types: level",
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "Level",
          "High Level"
        ]
      },
      "temperatureAlarmTypes": {
        "title": "Alarm types: temperature",
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "Temperature",
          "High Temperature",
          "Low Temperature"
        ]
      },
      "lowBatteryAlarmTypes": {
        "title": "Alarm types: low battery",
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "Low Battery Level",
          "Low Battery"
        ]
      },
      "levelAlarmConfigKey": {
        "title": "Tank attribute: level threshold alarm (JSON: enable, condition, thresholdMin, thresholdMax; %)",
        "type": "string",
        "default": "levelAlarmConfig"
      },
      "temperatureAlarmConfigKey": {
        "title": "Tank attribute: temperature threshold alarm (JSON: enable, condition, thresholdMin, thresholdMax; °C)",
        "type": "string",
        "default": "temperatureAlarmConfig"
      },
      "defaultMaxLevelThreshold": {
        "title": "A new tank's level alarm: above this level (%)",
        "type": "number",
        "default": 95
      },
      "defaultMaxTemperatureThreshold": {
        "title": "A new tank's temperature alarm: above this temperature (°C)",
        "type": "number",
        "default": 170
      },
      "burnerDeviceTypes": {
        "title": "Burner device profiles",
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "Burner"
        ]
      },
      "burnerLowTemperatureKey": {
        "title": "Burner telemetry: low temperature (true = fault)",
        "type": "string",
        "default": "lowTemperature"
      },
      "burnerPowerPhaseKeys": {
        "title": "Burner telemetry: power phases (false = fault)",
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "powerPhase1",
          "powerPhase2",
          "powerPhase3"
        ]
      }
    },
    "required": []
  },
  "form": [
    "tankDeviceTypes",
    "newTankDeviceType",
    "levelPercentKey",
    "levelKey",
    "temperatureKey",
    "tonnageKey",
    "batteryKey",
    "liquidTypeKey",
    "capacityKey",
    "capacityUnitsKey",
    "sensorUnitsKey",
    "minLevelThresholdKey",
    "levelAlarmTypes",
    "temperatureAlarmTypes",
    "lowBatteryAlarmTypes",
    "levelAlarmConfigKey",
    "temperatureAlarmConfigKey",
    "defaultMaxLevelThreshold",
    "defaultMaxTemperatureThreshold",
    "burnerDeviceTypes",
    "burnerLowTemperatureKey",
    "burnerPowerPhaseKeys"
  ]
}
