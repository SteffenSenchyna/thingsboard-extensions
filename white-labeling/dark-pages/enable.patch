@@ -833,4 +839,16 @@
 // pickers) — they win. Their colours are the palette's (the white-labeling's brand blue), not set here.
 :is(tb-root, .cdk-overlay-container, .tb-form-panel.outlined):not(#tb-rail) {
   @include shapes.app-shapes;
+}
+
+// ---- ThingsBoard's own pages, dark ---------------------------------------------------------------------------------
+// Its Material controls from the app's dark tokens, then its own surfaces (`dark-pages/_dark.scss`).
+#{$dark-pages} {
+  @include dark.tb-dark-material;
+  @include dark.tb-dark-thingsboard;
 }
+
+// The page under them: the dashboards' (ThingsBoard's own grey is on <body>, which the custom CSS can't reach).
+#{$dark-site} mat-sidenav-content:not(#tb-rail) {
+  background-color: var(--c-bg-neutral-min);
+}
